---
# 指定语言为 C++
Language: Cpp
# 基础风格继承自 Google (默认设置比较现代且广泛使用，在此基础上微调)
BasedOnStyle: Google

# ==============================================================================
# 基础缩进
# ==============================================================================
# 缩进宽度设为 4 个空格
IndentWidth: 4
# Tab 键的宽度也视作 4 个空格
TabWidth: 4
# 永远不要使用 Tab 字符，一律替换为空格（防止不同编辑器下显示错位）
UseTab: Never
# 访问修饰符（public/private/protected）向左缩进 4 格，使其与 class 关键字对齐
AccessModifierOffset: -4

# ==============================================================================
# 行宽与换行限制
# ==============================================================================
# 每行最大 120 个字符，超过则自动换行（现代宽屏显示器 120 刚好，不会太散也不会太挤）
ColumnLimit: 120
# 大括号风格：Attach（K&R 风格），即左大括号紧跟在语句末尾，不另起一行（ int main() { ）
BreakBeforeBraces: Attach
# 只有极短的函数（如 getter/setter）且只有一行时，才允许写在同一行
AllowShortFunctionsOnASingleLine: Inline
# 绝对不允许单行 if 语句（如 if(x) return; 必须换行并加大括号，防止未来加代码时漏掉括号引发血案）
AllowShortIfStatementsOnASingleLine: Never
# 绝对不允许单行循环语句
AllowShortLoopsOnASingleLine: false

# ==============================================================================
# 指针与引用对齐
# ==============================================================================
# 指针靠左对齐（写成 int* p，而非 int *p）
PointerAlignment: Left
# 引用也靠左，与指针保持一致（写成 int& r）
ReferenceAlignment: Pointer

# ==============================================================================
# 空格控制
# ==============================================================================
# 空的代码块内部不加空格，即 {}，而不是 { }
SpaceInEmptyBlock: false
# 小括号内部不加多余空格，如 func(a)，而不是 func( a )
SpacesInParentheses: false
# 中括号内部不加多余空格，如 arr[i]，而不是 arr[ i ]
SpacesInSquareBrackets: false

# ==============================================================================
# 参数换行与对齐
# ==============================================================================
# 函数调用的参数如果因超长而换行，尽量把能塞下的塞在同一行（紧凑模式）
BinPackArguments: true
# 函数定义的参数同理
BinPackParameters: true
# 换行后的参数，与左括号对齐，看起来更整齐
AlignAfterOpenBracket: Align

# ==============================================================================
# Include 排序（强迫症福音）
# ==============================================================================
# 开启自动整理 #include 排序
SortIncludes: true
# 定义 include 的优先级分组（数字越小越靠前，组与组之间会自动加空行）
IncludeCategories:
    - Regex: '^<.*'        # 第 1 梯队：尖括号包起来的系统库（如 <vector>, <memory>）
      Priority: 1
    - Regex: '^"Engine/.*' # 第 2 梯队：引擎内部头文件（如 "Engine/Engine.h"）
      Priority: 2
    - Regex: '^"game/.*'   # 第 3 梯队：游戏业务头文件（如 "game/Game.h"）
      Priority: 3
    - Regex: '.*'          # 第 4 梯队：其他第三方库（带引号的，如 "imgui.h"）
      Priority: 4