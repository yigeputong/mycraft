-vk::PresentModeKHR VulkanAPI::chooseSwapPresentMode(const std::vector<vk::PresentModeKHR>& modes) {
-    for (const auto& mode : modes) {
-        if (mode == vk::PresentModeKHR::eMailbox) return mode;
-    }
-    return vk::PresentModeKHR::eFifo;
