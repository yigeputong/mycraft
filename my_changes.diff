-void OpenGLAPI::DestroyShaderInternal(ShaderHandle h) {
-    auto it = m_shaders.find(h);
-    if (it == m_shaders.end()) return;
-    if (it->second.program) glDeleteProgram(it->second.program);
-    m_shaders.erase(it);
