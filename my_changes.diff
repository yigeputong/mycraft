-    MeshHandle h = CreateMeshInternal(data);
-    if (h == 0) return nullptr;
-    return MeshPtr(new Mesh(h), [this](Mesh* m) {
-        this->DestroyMeshInternal(m->GetHandle());
-        delete m;
-    });
