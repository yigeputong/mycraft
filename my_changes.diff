-    
-    vk::WriteDescriptorSet write{
-        .dstSet = *internal.set,
-        .dstBinding = 0,
-        .dstArrayElement = 0,
-        .descriptorCount = 1,
-        .descriptorType = vk::DescriptorType::eCombinedImageSampler,
-        .pImageInfo = &imageDesc
-    };
-    m_device.updateDescriptorSets(write, {});
-
-    TextureHandle handle = m_nextTexture++;
