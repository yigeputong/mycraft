-void VulkanAPI::pickPhysicalDevice() {
-    std::vector<vk::raii::PhysicalDevice> devices = m_instance.enumeratePhysicalDevices();
-    for (const auto& device : devices) {
-        if (isDeviceSuitable(device)) {
-            m_physicalDevice = device;
-            break;
-        }
