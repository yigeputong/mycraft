{
    "version": 6,
    "configurePresets": [
        {
            "name": "base",
            "hidden": true,
            "generator": "Ninja Multi-Config",
            "cacheVariables": {
                "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
                "VCPKG_OVERLAY_TRIPLETS": "${sourceDir}/triplets",
                "BUILD_SHARED_LIBS": "ON"
            }
        },
        {
            "name": "windows-base",
            "hidden": true,
            "inherits": "base",
            "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" },
            "cacheVariables": {
                "VCPKG_TARGET_TRIPLET": "x64-windows",
                "CMAKE_MSVC_RUNTIME_LIBRARY": "MultiThreaded$<$<CONFIG:Debug>:Debug>DLL"
            }
        },
        {
            "name": "linux-base",
            "hidden": true,
            "inherits": "base",
            "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" },
            "cacheVariables": {
                "VCPKG_TARGET_TRIPLET": "x64-linux"
            }
        },
        {
            "name": "android-base",
            "hidden": true,
            "inherits": "base",
            "cacheVariables": {
                "CMAKE_SYSTEM_NAME": "Android",
                "ANDROID_PLATFORM": "android-28",
                "ANDROID_STL": "c++_shared",
                "VCPKG_CHAINLOAD_TOOLCHAIN_FILE": "$env{ANDROID_NDK_HOME}/build/cmake/android.toolchain.cmake"
            }
        },
        {
            "name": "windows-msvc",
            "displayName": "Windows MSVC",
            "inherits": "windows-base",
            "binaryDir": "${sourceDir}/build/msvc"
        },
        {
            "name": "windows-msvc-asan",
            "displayName": "Windows MSVC ASan",
            "inherits": "windows-base",
            "binaryDir": "${sourceDir}/build/msvc-asan",
            "cacheVariables": {
                "SANITIZER": "address"
            }
        },
        {
            "name": "windows-clang",
            "displayName": "Windows Clang",
            "inherits": "windows-base",
            "binaryDir": "${sourceDir}/build/clang",
            "cacheVariables": {
                "CMAKE_C_COMPILER": "clang-cl",
                "CMAKE_CXX_COMPILER": "clang-cl"
            }
        },
        {
            "name": "windows-clang-asan",
            "displayName": "Windows Clang ASan",
            "inherits": "windows-base",
            "binaryDir": "${sourceDir}/build/clang-asan",
            "cacheVariables": {
                "CMAKE_C_COMPILER": "clang-cl",
                "CMAKE_CXX_COMPILER": "clang-cl",
                "SANITIZER": "address"
            }
        },
        {
            "name": "linux-gcc",
            "displayName": "Linux GCC",
            "inherits": "linux-base",
            "binaryDir": "${sourceDir}/build/gcc"
        },
        {
            "name": "linux-gcc-asan",
            "displayName": "Linux GCC ASan + UBSan",
            "inherits": "linux-base",
            "binaryDir": "${sourceDir}/build/gcc-asan",
            "cacheVariables": {
                "SANITIZER": "address+undefined"
            }
        },
        {
            "name": "linux-gcc-tsan",
            "displayName": "Linux GCC TSan",
            "inherits": "linux-base",
            "binaryDir": "${sourceDir}/build/gcc-tsan",
            "cacheVariables": {
                "SANITIZER": "thread"
            }
        },
        {
            "name": "linux-clang",
            "displayName": "Linux Clang",
            "inherits": "linux-base",
            "binaryDir": "${sourceDir}/build/clang",
            "cacheVariables": {
                "CMAKE_C_COMPILER": "clang",
                "CMAKE_CXX_COMPILER": "clang++"
            }
        },
        {
            "name": "android-arm64-v8a",
            "displayName": "Android arm64-v8a",
            "inherits": "android-base",
            "binaryDir": "${sourceDir}/build/android-arm64-v8a",
            "cacheVariables": {
                "ANDROID_ABI": "arm64-v8a",
                "VCPKG_TARGET_TRIPLET": "arm64-android"
            }
        },
        {
            "name": "android-x86_64",
            "displayName": "Android x86_64",
            "inherits": "android-base",
            "binaryDir": "${sourceDir}/build/android-x86_64",
            "cacheVariables": {
                "ANDROID_ABI": "x86_64",
                "VCPKG_TARGET_TRIPLET": "x64-android"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "windows-msvc-debug",
            "displayName": "Windows MSVC Debug",
            "configurePreset": "windows-msvc",
            "configuration": "Debug"
        },
        {
            "name": "windows-msvc-release",
            "displayName": "Windows MSVC Release",
            "configurePreset": "windows-msvc",
            "configuration": "Release"
        },
        {
            "name": "windows-msvc-asan-relwithdebinfo",
            "displayName": "Windows MSVC ASan (RelWithDebInfo)",
            "configurePreset": "windows-msvc-asan",
            "configuration": "RelWithDebInfo"
        },
        {
            "name": "windows-clang-debug",
            "displayName": "Windows Clang Debug",
            "configurePreset": "windows-clang",
            "configuration": "Debug"
        },
        {
            "name": "windows-clang-release",
            "displayName": "Windows Clang Release",
            "configurePreset": "windows-clang",
            "configuration": "Release"
        },
        {
            "name": "windows-clang-asan-relwithdebinfo",
            "displayName": "Windows Clang ASan (RelWithDebInfo)",
            "configurePreset": "windows-clang-asan",
            "configuration": "RelWithDebInfo"
        },
        {
            "name": "linux-gcc-debug",
            "displayName": "Linux GCC Debug",
            "configurePreset": "linux-gcc",
            "configuration": "Debug"
        },
        {
            "name": "linux-gcc-release",
            "displayName": "Linux GCC Release",
            "configurePreset": "linux-gcc",
            "configuration": "Release"
        },
        {
            "name": "linux-gcc-asan-relwithdebinfo",
            "displayName": "Linux GCC ASan (RelWithDebInfo)",
            "configurePreset": "linux-gcc-asan",
            "configuration": "RelWithDebInfo"
        },
        {
            "name": "linux-gcc-tsan-debug",
            "displayName": "Linux GCC TSan Debug",
            "configurePreset": "linux-gcc-tsan",
            "configuration": "Debug"
        },
        {
            "name": "linux-clang-debug",
            "displayName": "Linux Clang Debug",
            "configurePreset": "linux-clang",
            "configuration": "Debug"
        },
        {
            "name": "android-arm64-v8a-debug",
            "displayName": "Android arm64-v8a Debug",
            "configurePreset": "android-arm64-v8a",
            "configuration": "Debug"
        },
        {
            "name": "android-arm64-v8a-release",
            "displayName": "Android arm64-v8a Release",
            "configurePreset": "android-arm64-v8a",
            "configuration": "Release"
        },
        {
            "name": "android-x86_64-debug",
            "displayName": "Android x86_64 Debug",
            "configurePreset": "android-x86_64",
            "configuration": "Debug"
        }
    ]
}